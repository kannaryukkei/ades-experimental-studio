{
  "name": "nusa-forma-react-vite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.app.json",
    "check": "npm run typecheck && npm run build",
    "verify": "node scripts/verify-build.mjs",
    "test:e2e": "playwright test",
    "qa": "npm run check && npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "1.82.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.4.0"
  }
}
